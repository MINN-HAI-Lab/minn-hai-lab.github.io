---
/**
 * Home — the reach (canvas direction 2a), then Signal Plane (1c). See
 * src/layouts/Layout.astro for the chrome and the transcription notes that
 * apply to every page.
 *
 * Deep Field (1a) and Lattice (1b), the two sections that used to sit
 * between them, are gone — Kaung asked for them removed. Deep Field's
 * network graphic (mh-bg mode="bayes") moved to the Research page's Theme
 * 01 row rather than being deleted; see research.astro.
 *
 * Signal Plane's stats row ("2 research themes" / "1 open learning
 * resource, StatLab") is gone too — Kaung asked for it removed. The
 * headline block is now the section's only content, still centred.
 *
 * #top, the hero, is themed (D-053) — background and copy, and the 3D
 * scene inside it, told the active theme over postMessage since it's a
 * separate document these CSS custom properties can't reach on their own.
 * #signal-plane is themed too now (D-054), the same way; its mh-bg field
 * is themed from inside mh-bg.js itself, which — unlike the 3D scene —
 * shares this document and can just watch data-theme directly.
 */
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout>
<div class="mh-hero" style="position:relative">
<div id="top" class="mh-frame" style="position:relative;height:920px;background:var(--field);overflow:hidden">
<div style="position:absolute;inset:0;z-index:0;background:radial-gradient(90% 70% at 50% 48%,rgb(var(--hero-glow-rgb)) 0%,var(--field) 100%)"></div>
<iframe data-mh-scene src={`${base}/design/hands-scene.html`} title="Human and robot hands reaching toward each other" style="position:absolute;inset:0;z-index:1;width:100%;height:100%;border:0;background:transparent"></iframe>

<div class="mh-hero-copy" style="position:absolute;z-index:4;left:48px;bottom:118px;max-width:440px;display:flex;flex-direction:column;gap:20px;pointer-events:none">
  <div style="display:flex;align-items:center;gap:12px"><span style="width:7px;height:7px;border-radius:50%;background:#D61A4A;animation:mh-blink 2.6s ease-in-out infinite"></span><span style="font-size:12px;color:rgba(var(--ink-rgb),.6)">Human-centered AI</span></div>
  <h1 class="mh-hero-title" style="margin:0;font-family:Literata,serif;font-weight:300;font-size:54px;line-height:1.02;letter-spacing:-.025em;color:var(--display);text-wrap:pretty">The gap is the whole discipline.</h1>
  <p style="margin:0;font-size:17px;line-height:1.62;color:rgba(var(--ink-rgb),.72);max-width:42ch">We build AI that reaches back on human terms — adaptive, interpretable, accountable for how it arrived at what it says.</p>
</div>

</div>

<div style="position:absolute;z-index:5;left:0;right:0;bottom:0;border-top:1px solid rgba(var(--ink-rgb),.12);background:rgba(var(--field-rgb),.62);backdrop-filter:blur(10px);pointer-events:none">
  <div class="mh-gutter mh-wrap" style="display:flex;align-items:center;justify-content:flex-end;gap:32px;padding:20px 48px">
        <div class="mh-wrap" style="display:flex;gap:26px;align-items:center;pointer-events:auto">
                  <a href={`${base}/research`} style="font-size:12.5px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4);padding-bottom:2px">Enter the lab</a>
    </div>
  </div>
</div>
</div>
<div style="display:flex;flex-direction:column;background:var(--field)">

<div id="signal-plane" class="mh-frame" style="position:relative;height:860px;background:var(--field);display:flex;flex-direction:column;border-bottom:1px solid rgba(var(--ink-rgb),.1)">
<mh-bg mode="grid" speed="1" style="position:absolute;inset:0;z-index:0"></mh-bg>
<div style="position:absolute;inset:0;z-index:1;background:radial-gradient(70% 55% at 50% 34%,rgba(var(--field-rgb),.9) 0%,rgba(var(--field-rgb),.45) 55%,rgba(var(--field-rgb),0) 80%)"></div>
<div style="position:relative;z-index:2;flex:1 0 auto;display:flex;flex-direction:column">

  <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;text-align:center;padding:0 44px">
    <span style="font-size:12px;color:rgba(var(--ink-rgb),.5)">Human-centered AI</span>
    <h2 class="mh-display-104" style="margin:0;font-family:Literata,serif;font-weight:300;font-size:104px;line-height:.95;letter-spacing:-.035em;color:var(--display);max-width:16ch">We model the Human, not the AI alone.</h2>
    <p style="margin:0;font-size:17.5px;line-height:1.6;color:rgba(var(--ink-rgb),.7);max-width:58ch">Adaptive, interpretable, socially responsible systems — designed to perform and to be accountable for how they performed.</p>
    <a href={`${base}/research`} style="margin-top:8px;font-size:13.5px;color:var(--field);background:var(--ink);text-decoration:none;border-radius:999px;padding:15px 30px;font-weight:500">Enter the lab</a>
  </div>
</div>
</div>
</div>
</Layout>
