---
/**
 * Join the Lab — how to apply. See src/layouts/Layout.astro for the chrome
 * and the transcription notes that apply to every page.
 *
 * The nav tab used to point straight at the Google Form. It lands here
 * instead, so an applicant reads who the lab is looking for and what
 * happens after they apply before they open the form.
 *
 * padding-top:96px on the wrapper clears the fixed header, the same way
 * Learning and Collaborations do: this is a plain gutter section starting
 * near the top of the page rather than one of the canvas's full-bleed
 * dark bands, so the header's height has to be reserved above it.
 */
import Layout from '../layouts/Layout.astro';

const form = 'https://forms.gle/UQpNsfC2UsKvSPwh6';
---

<Layout title="Join the Lab — MINN HAI Lab">
<div style="background:var(--field);padding-top:96px">
  <div class="mh-gutter" id="join" style="padding:44px;border-bottom:1px solid rgba(var(--ink-rgb),.1);display:flex;flex-direction:column;gap:20px">
    <div class="mh-wrap" style="display:flex;align-items:baseline;justify-content:space-between;gap:4px 16px"><h3 style="margin:0;font-family:Literata,serif;font-weight:400;font-size:30px;letter-spacing:-.015em">Join the Lab</h3><span style="font-size:12.5px;color:rgba(var(--ink-rgb),.5)">Expression of Interest Form</span></div>
    <div style="display:flex;flex-direction:column;gap:14px;max-width:70ch">
      <p style="margin:0;font-size:14.5px;line-height:1.6;color:rgba(var(--ink-rgb),.68)">The Human-Centred AI Lab welcomes anyone interested in research in artificial intelligence and related areas, including Sequential Modeling, Reinforcement Learning, Causal Explanation, Generative Modeling for vision and language, and more.</p>
      <p style="margin:0;font-size:14.5px;line-height:1.6;color:rgba(var(--ink-rgb),.68)">This is our <a href={form} target="_blank" rel="noopener" style="color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">Expression of Interest Form</a>. Please fill in the required information, along with:</p>
      <ul style="margin:-4px 0 0;font-size:14.5px;line-height:1.6;color:rgba(var(--ink-rgb),.68);padding:0 0 0 20px;display:flex;flex-direction:column;gap:4px">
        <li>your updated CV</li>
        <li>the research direction you’d like to pursue</li>
        <li>why you want to join HAI Lab</li>
      </ul>
      <p style="margin:0;font-size:14.5px;line-height:1.6;color:rgba(var(--ink-rgb),.68)">The faculty will review applications on a rolling basis, and we’ll be in touch within two weeks. If you have questions before applying, email us at <a href="mailto:minnlabth@gmail.com" style="color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">minnlabth@gmail.com</a>.</p>
    </div>
  </div>
</div>
</Layout>
