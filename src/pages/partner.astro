---
/**
 * Partner with us — Funding through the closing band. See
 * src/layouts/Layout.astro for the chrome and the transcription notes that
 * apply to every page.
 *
 * padding-top:96px on the wrapper clears the fixed header; see the same
 * note in learning.astro.
 *
 * #join carries an mh-bg field (mode="grid"), the same as Home's
 * #signal-plane, and is themed the same way (D-054) — its own background
 * and text as var()s, its field themed from inside mh-bg.js itself.
 */
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* Collaborating institutions. The logos in public/collaborations/ are trimmed to
   their own content and normalised to one height, so a wide wordmark and a compact
   mark carry the same optical weight in the same box. */
const collaborators = [
  { name: 'Institut Polytechnique de Paris', place: 'France', logo: 'ip-paris.png' },
  { name: 'Inria Saclay', place: 'France', logo: 'inria.png' },
  { name: 'National Institute of Informatics', place: 'Japan', logo: 'nii.png' },
  { name: 'University of Montreal', place: 'Canada', logo: 'montreal.png' },
  { name: 'University of Quebec', place: 'Canada', logo: 'quebec.png' },
];
---

<Layout title="Email Us">
<div style="background:var(--field);padding-top:96px">
  <div class="mh-gutter" id="collaborations" style="padding:44px;border-bottom:1px solid rgba(var(--ink-rgb),.1);display:flex;flex-direction:column;gap:20px">
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px"><h3 style="margin:0;font-family:Literata,serif;font-weight:400;font-size:30px;letter-spacing:-.015em">Academic Collaborations</h3><span style="font-size:12.5px;color:rgba(var(--ink-rgb),.5)">Partner institutions</span></div>
    <p style="margin:0;font-size:14.5px;line-height:1.6;color:rgba(var(--ink-rgb),.68);max-width:70ch">We work with colleagues at the following institutions.</p>
    <ul style="list-style:none;margin:4px 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:24px 20px">
      {collaborators.map((c) => (
        <li style="display:flex;flex-direction:column;gap:10px">
          <span style="display:flex;align-items:center;justify-content:flex-start;height:76px;padding:14px 18px;background:rgb(239,241,242);border-radius:2px"><img src={`${base}/collaborations/${c.logo}`} alt={c.name} loading="lazy" style="max-height:100%;max-width:100%;width:auto;object-fit:contain" /></span>
          <span style="display:flex;flex-direction:column;gap:2px"><span style="font-size:13.5px;line-height:1.35;color:rgba(var(--ink-rgb),.78)">{c.name}</span><span style="font-size:12.5px;color:rgba(var(--ink-rgb),.45)">{c.place}</span></span>
        </li>
      ))}
    </ul>
  </div>

  <div class="mh-gutter" id="funding" style="padding:44px;border-bottom:1px solid rgba(var(--ink-rgb),.1);display:flex;flex-direction:column;gap:20px">
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px"><h3 style="margin:0;font-family:Literata,serif;font-weight:400;font-size:30px;letter-spacing:-.015em">Funding</h3><span style="font-size:12.5px;color:rgba(var(--ink-rgb),.5)">Sponsors and funding agencies</span></div>
    <p style="margin:0;font-size:14.5px;line-height:1.6;color:rgba(var(--ink-rgb),.68);max-width:70ch">We would like to thank the following sponsors and funding agencies for supporting our research.</p>
    <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid rgba(var(--ink-rgb),.08);max-width:80ch">
      <li style="padding:12px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08);font-size:14px;line-height:1.5;color:rgba(var(--ink-rgb),.78)">Uni Kyoto-Inria associate team grant <span style="color:rgba(var(--ink-rgb),.45)">— Inria, France</span></li>
      <li style="padding:12px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08);font-size:14px;line-height:1.5;color:rgba(var(--ink-rgb),.78)">Natural Sciences and Engineering Research Council of Canada (NSERC) <span style="color:rgba(var(--ink-rgb),.45)">— Canada</span></li>
      <li style="padding:12px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08);font-size:14px;line-height:1.5;color:rgba(var(--ink-rgb),.78)">National Natural Science Foundation of China (NSFC) <span style="color:rgba(var(--ink-rgb),.45)">— China</span></li>
      <li style="padding:12px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08);font-size:14px;line-height:1.5;color:rgba(var(--ink-rgb),.78)">National Institute of Informatics visiting research grant <span style="color:rgba(var(--ink-rgb),.45)">— Japan</span></li>
      <li style="padding:12px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08);font-size:14px;line-height:1.5;color:rgba(var(--ink-rgb),.78)">Singapore Management University visiting research grant <span style="color:rgba(var(--ink-rgb),.45)">— Singapore</span></li>
      <li style="padding:12px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08);font-size:14px;line-height:1.5;color:rgba(var(--ink-rgb),.78)">Science and Technology Foundation of Xiamen <span style="color:rgba(var(--ink-rgb),.45)">— China</span></li>
      <li style="padding:12px 0;font-size:14px;line-height:1.5;color:rgba(var(--ink-rgb),.78)">Science Foundation of Huaqiao University <span style="color:rgba(var(--ink-rgb),.45)">— China</span></li>
    </ul>
  </div>

  <div id="join" style="position:relative;height:300px;overflow:hidden;background:var(--field)">
    <mh-bg mode="grid" speed="1" style="position:absolute;inset:0;z-index:0"></mh-bg>
    <div style="position:absolute;inset:0;z-index:1;background:radial-gradient(60% 70% at 50% 40%,rgba(var(--field-rgb),.86) 0%,rgba(var(--field-rgb),.4) 60%,rgba(var(--field-rgb),.1) 100%)"></div>
    <div style="position:relative;z-index:2;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;text-align:center;padding:0 44px">
      <h3 style="margin:0;font-family:Literata,serif;font-weight:300;font-size:44px;line-height:1.05;letter-spacing:-.025em;max-width:24ch;color:var(--ink)">Bring us a problem that needs a solution.</h3>
      <div class="mh-wrap" style="display:flex;justify-content:center;gap:12px"><a href="mailto:minnlabth@gmail.com" style="font-size:13px;color:var(--field);background:var(--ink);text-decoration:none;border-radius:2px;padding:13px 22px;font-weight:500">Partner with the lab</a></div>
      <a href="mailto:sein.minn.cs@gmail.com" style="font-size:12.5px;color:rgba(var(--ink-rgb),.6);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.28)">minnlabth@gmail.com</a>
    </div>
  </div>
</div>
</Layout>
