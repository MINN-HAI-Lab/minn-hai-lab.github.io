---
/**
 * Members — grouped Faculty / Post Doctoral / Doctoral / Master / Intern,
 * one profile row per person (D-055). See src/layouts/Layout.astro for
 * the chrome and the transcription notes that apply to every page.
 *
 * A group with no active people renders nothing at all — not even its
 * heading (D-062) — so a group waiting entirely on people who haven't
 * arrived yet doesn't show as an empty label on the page. Post Doctoral
 * and Intern are like this right now: every entry is commented out
 * below, ready to uncomment once someone real replaces it.
 *
 * padding-top:96px on the wrapper clears the fixed header; see the same
 * note in learning.astro.
 *
 * ── How to add or fill in a member ─────────────────────────────────────
 * Everything on this page comes from the `groups` array below. Each
 * person is one object; the template renders whatever is filled in and
 * marks whatever isn't with a TODO. To add someone or complete an entry,
 * edit the data only — the markup below needs no change.
 *
 *   {
 *     name:  'Full Name',            // null while unknown → "TODO: name"
 *     role:  'PhD student',          // shown under the name
 *     photo: 'Full_Name.jpg',        // null while unknown → striped placeholder
 *     bio:   ['Two sentences, third person.'],      // null while unknown
 *     links: [                                       // [] while unknown
 *       { label: 'Google Scholar', href: 'https://scholar.google.com/…' },
 *       { label: 'LinkedIn',       href: 'https://www.linkedin.com/in/…' },
 *     ],
 *   }
 *
 * Photo: drop the original in pics/ (gitignored), then resize it into
 * public/members/ under the same name the `photo` field uses —
 *   sips -Z 900 -s formatOptions 82 pics/Full_Name.jpg --out public/members/Full_Name.jpg
 * — the same treatment every existing portrait had (D-040, D-049).
 *
 * Bio and links must be supplied by the member (or by Kaung on their
 * behalf). Do not write a bio for a real person from nothing, and do
 * not guess a URL — a wrong link or an invented claim on a researcher's
 * public profile is worse than a visible TODO.
 *
 * Every bio is exactly two sentences, third person, one paragraph
 * (D-059). When a member supplies more, condense it to two sentences
 * using only the facts they gave — who they are and what they work on,
 * then where they came from — and drop the rest; add nothing. Bio copy
 * follows the site's rules: sentence case, no exclamation marks, no
 * emoji. Link labels are the service's own name ("Google Scholar",
 * "LinkedIn", "Facebook", "GitHub", "ORCID", "Website"…); any number, in
 * any order. A label that has a glyph in `icons` below renders as that
 * icon (D-056): Google Scholar, LinkedIn, Facebook, GitHub, "Website"
 * for a personal or portfolio site (a globe, D-058), and "Email" for a
 * `mailto:` link (an envelope, D-060). Any
 * other label renders as a small text pill, which is fine — don't
 * invent a glyph, add one only from the service's own mark.
 * ───────────────────────────────────────────────────────────────────────
 *
 * Portraits are public/members/<Name>.jpg, resized from the originals in
 * pics/ down to 900px on the long side for the web.
 */
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type Link = { label: string; href: string };
type Person = { name: string | null; role: string; photo: string | null; bio: string[] | null; links: Link[] };
type Group = { label: string; people: Person[] };

const groups: Group[] = [
  {
    label: 'Faculty',
    people: [
      {
        name: 'Dr. Sein Minn',
        role: 'Faculty',
        photo: 'Sein_Minn.jpg',
        bio: [
          'Dr. Sein Minn is an assistant professor at the Asian Institute of Technology in Thailand, researching adaptive, interpretable systems at the intersection of machine learning, user modeling and cognitive modeling, with a broader commitment to human-centered and explainable AI. He received his Ph.D. in Computer Engineering from Université de Montréal, and previously worked at Université du Québec à Montréal in Canada and at École Polytechnique, CNRS and Inria in France.',
        ],
        links: [
          { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=4cXYLugAAAAJ&hl=en' },
          { label: 'Website', href: 'https://simon-tan.github.io/' },
          { label: 'LinkedIn', href: 'https://www.linkedin.com/in/sein-minn-4bb9b584/' },
        ],
      },
    ],
  },
  {
    label: 'Post Doctoral',
    people: [
      // Two postdocs still to arrive — uncomment and fill in each as they do.
      // { name: null, role: 'Postdoctoral researcher', photo: null, bio: null, links: [] },
      // { name: null, role: 'Postdoctoral researcher', photo: null, bio: null, links: [] },
    ],
  },
  {
    label: 'Doctoral',
    people: [
      {
        name: 'Md Kamal Hosen',
        role: 'PhD student',
        photo: 'Md_Kamal_Hosen.jpg',
        bio: [
          'Kamal is a PhD researcher in Data Science and Artificial Intelligence at the Asian Institute of Technology, developing physics-informed neural operators for modeling urban heat at the canopy layer. He is also a Geospatial Web Developer at the Asian Disaster Preparedness Center in Bangkok, building GeoAI systems for flood, disaster and environmental monitoring across eight countries in Asia.',
        ],
        links: [{ label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=Q6NL-FEAAAAJ&hl=en' }],
      },
      // Two more PhD students still to arrive — uncomment and fill in each as they do.
      // { name: null, role: 'PhD student', photo: null, bio: null, links: [] },
      // { name: null, role: 'PhD student', photo: null, bio: null, links: [] },
    ],
  },
  {
    label: 'Master',
    people: [
      { name: 'Aung Khant Maung', role: "Master's student", photo: 'Aung_Khant_Maung.jpg', bio: null, links: [] },
      { name: 'Thet Htun Swe', role: "Master's student", photo: 'Thet_Htun_Swe.jpg', bio: null, links: [] },
      {
        name: 'Kaung Hein Htet',
        role: "Master's student",
        photo: 'Kaung_Hein_Htet.jpg',
        bio: [
          'Kaung Hein Htet is a Master’s candidate in Data Science and AI at the Asian Institute of Technology. His research focuses on personalized knowledge tracing and knowledge graphs.',
        ],
        links: [
          { label: 'Website', href: 'https://my-portfolio-iota-teal-39.vercel.app/' },
          { label: 'LinkedIn', href: 'https://www.linkedin.com/in/kaung-hein-htet' },
          { label: 'Email', href: 'mailto:kaungheinhtetutyccmm@gmail.com' },
        ],
      },
      { name: 'Win Htut Naing', role: "Master's student", photo: 'Win_Htut_Naing.jpg', bio: null, links: [] },
    ],
  },
  {
    label: 'Intern',
    people: [
      // An intern still to arrive — uncomment and fill in once they do.
      // { name: null, role: 'Intern', photo: null, bio: null, links: [] },
    ],
  },
];

// What a row is still waiting on, for its TODO marker.
const missing = (p: Person) =>
  [!p.name && 'name and photo', !p.bio && 'bio', p.links.length === 0 && 'links (Google Scholar, LinkedIn, …)'].filter(
    (x): x is string => Boolean(x),
  );

// Link icons (D-056): one monochrome glyph per service, keyed by the link's
// label, drawn with currentColor so it takes the ink of whichever theme is
// on. A label with no glyph here falls back to a text pill — add a path to
// give it one. Paths are the services' own marks, 24×24, from Simple Icons
// (CC0), filled; "Website" is a generic globe, stroked (D-058), since a
// personal site has no mark of its own.
type Glyph = { d: string; stroke?: true };
const icons: Record<string, Glyph> = {
  'Google Scholar': { d: 'M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z' },
  LinkedIn: { d: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' },
  Facebook: { d: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z' },
  GitHub: { d: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12' },
  Website: { d: 'M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM3 12h18M12 3c-3 3.5-3 14.5 0 18M12 3c3 3.5 3 14.5 0 18', stroke: true },
  Email: { d: 'M3 5h18v14H3zM3 5l9 8 9-8', stroke: true },
};
---

<Layout title="Members — MINN HAI Lab">
<div style="background:var(--field);padding-top:96px">
  <div class="mh-gutter" id="members" style="padding:44px;border-bottom:1px solid rgba(var(--ink-rgb),.1);display:flex;flex-direction:column;gap:44px">
    <div style="display:flex;align-items:baseline;justify-content:space-between"><h3 style="margin:0;font-family:Literata,serif;font-weight:400;font-size:30px;letter-spacing:-.015em">Members</h3></div>
    {groups.filter((g) => g.people.length > 0).map((g) => (
      <div style="display:flex;flex-direction:column;gap:12px">
        <div style="font-family:Literata,serif;font-size:19px;line-height:1.3">{g.label}</div>
        <div style="display:flex;flex-direction:column">
          {g.people.map((p) => (
            <div class="mh-profile" style="display:grid;grid-template-columns:240px minmax(0,1fr);gap:40px;align-items:start;padding:28px 0;border-top:1px solid rgba(var(--ink-rgb),.08)">
              {p.photo ? (
                <div style="aspect-ratio:4/5;border:1px solid rgba(var(--ink-rgb),.14);border-radius:3px;overflow:hidden">
                  <img src={`${base}/members/${p.photo}`} alt={p.name ?? ''} loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block" />
                </div>
              ) : (
                <div style="aspect-ratio:4/5;border:1px solid rgba(var(--ink-rgb),.14);border-radius:3px;background:repeating-linear-gradient(135deg,rgba(var(--ink-rgb),.05) 0 6px,transparent 6px 12px);display:flex;align-items:flex-end;padding:12px">
                  <span style="font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:rgba(var(--ink-rgb),.5)">portrait</span>
                </div>
              )}
              <div style="display:flex;flex-direction:column;gap:14px;min-width:0">
                <div>
                  <div style="font-family:Literata,serif;font-size:16px">{p.name ?? 'TODO: name'}</div>
                  <div style="font-size:12px;color:rgba(var(--ink-rgb),.5);margin-top:3px">{p.role}</div>
                </div>
                {p.bio && p.bio.map((t) => (
                  <p style="margin:0;font-size:14.5px;line-height:1.6;color:rgba(var(--ink-rgb),.7);text-align:justify;hyphens:auto">{t}</p>
                ))}
                {p.links.length > 0 && (
                  <div style="display:flex;flex-wrap:wrap;gap:8px">
                    {p.links.map((l) => icons[l.label] ? (
                      <a href={l.href} target="_blank" rel="noopener" aria-label={l.label} title={l.label} style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border:1px solid rgba(var(--ink-rgb),.18);border-radius:2px;color:rgba(var(--ink-rgb),.72)">
                        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" style={icons[l.label].stroke ? 'fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;display:block' : 'fill:currentColor;display:block'}><path d={icons[l.label].d} /></svg>
                      </a>
                    ) : (
                      <a href={l.href} target="_blank" rel="noopener" style="border:1px solid rgba(var(--ink-rgb),.18);border-radius:2px;padding:5px 10px;font-size:12px;color:rgba(var(--ink-rgb),.72);text-decoration:none">{l.label}</a>
                    ))}
                  </div>
                )}
                {missing(p).length > 0 && (
                  <div style="border-left:3px solid rgba(var(--ink-rgb),.4);background:rgba(var(--field-rgb),.75);border-radius:3px;padding:12px 14px;font-size:13px;line-height:1.6;color:rgba(var(--ink-rgb),.82)">TODO: {missing(p).join(', ')} — to be supplied by the member.</div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
</Layout>
