---
/**
 * Research — the research band, then the three themes, zigzagging left and
 * right. See src/layouts/Layout.astro for the chrome and the transcription
 * notes that apply to every page.
 *
 * Supersedes D-042's three-column layout — Kaung asked for two columns per
 * theme instead, alternating text and visual side, text/visual/text down
 * the left, visual/text/visual down the right. .mh-zigzag (Layout.astro) is
 * the grid: 2 columns at 992px and up, 1 below, no canvas equivalent.
 *
 * Theme 01's visual is mh-bg mode="bayes", the network graphic that used to
 * sit in Home's Deep Field section (now removed — see index.astro), shown
 * unpanelled — no border (D-048) — straight on the page. It does carry a
 * background, though: mh-bg's canvas is transparent, so without one this
 * panel would just show whatever the page around it does — that page is
 * themed now (D-054), so its own background is var(--field), same as the
 * page. Theme 02 and Theme 03's visuals are mh-bg fields too (D-065),
 * mode="blanket" and mode="generate", each in the same 420px var(--field)
 * panel as Theme 01's: a Markov blanket ringed inside a Bayesian network,
 * and a cat, as a dot matrix, emerging from noise the way a diffusion
 * model's reverse process does (D-066). They replaced the "image / 3D
 * object" placeholders Kaung
 * had marked; see public/design/mh-bg.js for what each one draws. The
 * header band's own mh-bg (mode="lattice") is gone, redundant once
 * Theme 01 carried a real network graphic of its own.
 *
 * Theme 03, "Visual generative modeling", has a real description now
 * (Kaung's request, drafted with the personal-humanizer skill to match
 * Theme 01 and 02's voice). It has no publications yet; its Publications
 * block is commented out in the template below (D-067), not shown as a
 * TODO, until there are some to list.
 */
import Layout from '../layouts/Layout.astro';
---

<Layout title="Research — MINN HAI Lab">
<div style="background:var(--field)">
<div id="research" style="position:relative;padding:0;border-bottom:1px solid rgba(var(--ink-rgb),.1)">
    <div style="position:relative;height:280px;overflow:hidden">
      <div style="position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(var(--field-rgb),.7) 0%,rgba(var(--field-rgb),.35) 40%,rgba(var(--field-rgb),.95) 100%)"></div>
      <div class="mh-gutter" style="position:relative;z-index:2;height:100%;display:flex;flex-direction:column;justify-content:flex-end;padding:44px">
        <h2 style="margin:0;font-family:Literata,serif;font-weight:300;font-size:52px;line-height:1;letter-spacing:-.025em">Research</h2>
        <p style="margin:14px 0 0;font-size:16px;color:rgba(var(--ink-rgb),.68);max-width:54ch">Three research themes, and the publications behind them.</p>
      </div>
    </div>
  </div>

  <div class="mh-gutter mh-zigzag" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:start;padding:56px 44px;border-bottom:1px solid rgba(var(--ink-rgb),.1)">
    <div style="display:flex;flex-direction:column;gap:14px">
      <div style="font-size:12.5px;color:rgba(var(--ink-rgb),.45);line-height:1.5">Theme 01</div>
      <h3 style="margin:0;font-family:Literata,serif;font-weight:400;font-size:30px;line-height:1.15;letter-spacing:-.015em">AI for Human Behavior Modeling</h3>
      <p style="margin:0;font-size:16px;line-height:1.62;color:rgba(var(--ink-rgb),.7)">Knowledge tracing: estimating what a learner has mastered, attempt by attempt, and reporting how uncertain that estimate is. The estimate is the model's claim about a person, so it is always shown with its band.</p>
      <div style="margin-top:10px">
        <div style="font-size:12px;color:rgba(var(--ink-rgb),.45);letter-spacing:.01em">Publications</div>
        <ul style="list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column;border-top:1px solid rgba(var(--ink-rgb),.08)">
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08)"><a href="https://link.springer.com/chapter/10.1007/978-3-031-98462-4_53" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">EIKT</a><span style="font-size:12.5px;color:rgba(var(--ink-rgb),.5)">AIED, 2025</span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08)"><a href="https://arxiv.org/pdf/2207.03202" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">Privacy-Preserving Synthetic Data Generation</a><span style="font-size:12.5px;color:rgba(var(--ink-rgb),.5)">EC-TEL, 2018</span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08)"><a href="https://cdn.aaai.org/ojs/21560/21560-13-25573-1-2-20220628.pdf" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">IKT</a><span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(var(--ink-rgb),.5)">AAAI, 2022<a href="https://github.com/simon-tan/IKT" target="_blank" rel="noopener" style="border:1px solid rgba(var(--ink-rgb),.18);border-radius:2px;padding:2px 7px;font-size:10.5px;color:rgba(var(--ink-rgb),.62);text-decoration:none">code</a></span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08)"><a href="https://arxiv.org/pdf/2012.12218" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">BKT-LSTM</a><span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(var(--ink-rgb),.5)">Arxiv, 2021<a href="https://github.com/Simon-tan/BKT-LSTM" target="_blank" rel="noopener" style="border:1px solid rgba(var(--ink-rgb),.18);border-radius:2px;padding:2px 7px;font-size:10.5px;color:rgba(var(--ink-rgb),.62);text-decoration:none">code</a></span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08)"><a href="https://ink.library.smu.edu.sg/cgi/viewcontent.cgi?article=5350&amp;context=sis_research" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">DSCMN</a><span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(var(--ink-rgb),.5)">PAKDD, 2019<a href="https://github.com/Simon-tan/DSCMN" target="_blank" rel="noopener" style="border:1px solid rgba(var(--ink-rgb),.18);border-radius:2px;padding:2px 7px;font-size:10.5px;color:rgba(var(--ink-rgb),.62);text-decoration:none">code</a></span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08)"><a href="https://arxiv.org/pdf/1809.08713" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">DKT-DSC</a><span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(var(--ink-rgb),.5)">ICDM, 2018<a href="https://github.com/Simon-tan/DKT-DSC" target="_blank" rel="noopener" style="border:1px solid rgba(var(--ink-rgb),.18);border-radius:2px;padding:2px 7px;font-size:10.5px;color:rgba(var(--ink-rgb),.62);text-decoration:none">code</a></span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08)"><a href="https://ink.library.smu.edu.sg/cgi/viewcontent.cgi?article=5330&amp;context=sis_research" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">KT</a><span style="font-size:12.5px;color:rgba(var(--ink-rgb),.5)">ICDM, 2018</span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08)"><a href="https://www.professeurs.polymtl.ca/michel.desmarais/Publications-Michel/EC-TEL_2016_paper_185.pdf" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">Q-matrix Reinment</a><span style="font-size:12.5px;color:rgba(var(--ink-rgb),.5)">EC-TEL, 2016</span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0"><a href="https://files.eric.ed.gov/fulltext/ED562315.pdf" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">Uni Library Rec. Syst.</a><span style="font-size:12.5px;color:rgba(var(--ink-rgb),.5)">e-Learning, 2013</span></li>
        </ul>
      </div>
    </div>
    <div style="position:relative;height:420px;background:var(--field)">
      <mh-bg mode="bayes" speed="1" style="position:absolute;inset:0;z-index:0"></mh-bg>
    </div>
  </div>

  <div class="mh-gutter mh-zigzag" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:start;padding:56px 44px;border-bottom:1px solid rgba(var(--ink-rgb),.1)">
    <div style="position:relative;height:420px;background:var(--field)">
      <mh-bg mode="blanket" speed="1" style="position:absolute;inset:0;z-index:0"></mh-bg>
    </div>
    <div style="display:flex;flex-direction:column;gap:14px">
      <div style="font-size:12.5px;color:rgba(var(--ink-rgb),.45);line-height:1.5">Theme 02</div>
      <h3 style="margin:0;font-family:Literata,serif;font-weight:400;font-size:30px;line-height:1.15;letter-spacing:-.015em">Causal Explanation for Human Understanding</h3>
      <p style="margin:0;font-size:16px;line-height:1.62;color:rgba(var(--ink-rgb),.7)">Bayesian networks and Markov blankets: identifying the smallest set of variables that renders a target conditionally independent of everything else, so an explanation names variables rather than gesturing at importance scores.</p>
      <div style="margin-top:10px">
        <div style="font-size:12px;color:rgba(var(--ink-rgb),.45);letter-spacing:.01em">Publications</div>
        <ul style="list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column;border-top:1px solid rgba(var(--ink-rgb),.08)">
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08)"><a href="https://arxiv.org/pdf/2310.00570" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">LAPLACE</a><span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(var(--ink-rgb),.5)">Arxiv, 2023<a href="https://github.com/Simon-tan/LaPLACE" target="_blank" rel="noopener" style="border:1px solid rgba(var(--ink-rgb),.18);border-radius:2px;padding:2px 7px;font-size:10.5px;color:rgba(var(--ink-rgb),.62);text-decoration:none">code</a></span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08)"><a href="https://www.computer.org/csdl/proceedings-article/icdmw/2023/816400a966/1UjHSKsoytO" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">FSBN &amp; SSBN</a><span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(var(--ink-rgb),.5)">ICDM, 2023<span style="font-size:11px;color:rgba(var(--ink-rgb),.4);font-style:italic">CXAI workshop</span></span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08)"><a href="https://ieeexplore.ieee.org/abstract/document/7058101" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">GBNC</a><span style="font-size:12.5px;color:rgba(var(--ink-rgb),.5)">DSAA, 2014</span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(var(--ink-rgb),.08)"><a href="http://link.springer.com/chapter/10.1007/978-3-319-08979-9_2" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">GMBNC</a><span style="font-size:12.5px;color:rgba(var(--ink-rgb),.5)">MLDM, 2014</span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0"><a href="https://www.oalib.com/research/5205821" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(var(--ink-rgb),.4)">MBNC</a><span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(var(--ink-rgb),.5)">Computer Science and Application, 2014<span style="font-size:11px;color:rgba(var(--ink-rgb),.4);font-style:italic">in Chinese</span></span></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="mh-gutter mh-zigzag" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:start;padding:56px 44px">
    <div style="display:flex;flex-direction:column;gap:14px">
      <div style="font-size:12.5px;color:rgba(var(--ink-rgb),.45);line-height:1.5">Theme 03</div>
      <h3 style="margin:0;font-family:Literata,serif;font-weight:400;font-size:30px;line-height:1.15;letter-spacing:-.015em">Visual generative modeling</h3>
      <p style="margin:0;font-size:16px;line-height:1.62;color:rgba(var(--ink-rgb),.7)">Learning what makes an image or video plausible well enough to generate new ones, not just classify or detect what's already there. A model that can generate a scene has learned something about its structure, so generation doubles as a test of whether a system understands what it sees.</p>
      {/* Theme 03's publications, commented out until there are some to list
          (D-067). Uncomment the block and replace the TODO marker with a
          <ul> shaped like Theme 01's and 02's — the label stays with it, so
          the theme doesn't show a "Publications" heading over nothing.
      <div style="margin-top:10px">
        <div style="font-size:12px;color:rgba(var(--ink-rgb),.45);letter-spacing:.01em">Publications</div>
        <div style="border-left:3px solid rgba(var(--ink-rgb),.4);background:rgba(var(--field-rgb),.75);border-radius:3px;padding:14px 16px;margin-top:10px;font-size:13px;line-height:1.6;color:rgba(var(--ink-rgb),.82)">TODO: publications for this theme, to be supplied.</div>
      </div>
      */}
    </div>
    <div style="position:relative;height:420px;background:var(--field)">
      <mh-bg mode="generate" speed="1" style="position:absolute;inset:0;z-index:0"></mh-bg>
    </div>
  </div>
</div>
</Layout>
